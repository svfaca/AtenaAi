# ====================================
# DOCKER ENVIRONMENT VARIABLES
# ====================================
# Copie este arquivo para .env e preencha com seus valores
# cp .env.docker .env

# ====================================
# BUILD CONFIG
# ====================================
# Options: development, production
BUILD_TARGET=development
ENVIRONMENT=development
NODE_ENV=development

# ====================================
# PORTS
# ====================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# ====================================
# DATABASE (PostgreSQL)
# ====================================
POSTGRES_DB=atenaai
POSTGRES_USER=atenaai
POSTGRES_PASSWORD=atenaai123

# Para o backend usar
DATABASE_URL=postgresql://atenaai:atenaai123@db:5432/atenaai

# ====================================
# BACKEND CONFIG
# ====================================
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
API_VERSION=2.0.0
ACCESS_TOKEN_EXPIRE_MINUTES=21600
LOG_LEVEL=INFO

# ====================================
# AI CONFIG (OpenAI)
# ====================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ====================================
# CORS
# ====================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# ====================================
# FRONTEND CONFIG
# ====================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ====================================
# PRODUCTION OVERRIDES
# ====================================
# Para produção, altere:
# BUILD_TARGET=production
# ENVIRONMENT=production
# NODE_ENV=production
# SECRET_KEY=<use: openssl rand -hex 32>
# POSTGRES_PASSWORD=<senha forte>
# CORS_ORIGINS=https://seu-dominio.com
# NEXT_PUBLIC_API_URL=https://api.seu-dominio.com
# NEXT_PUBLIC_WS_URL=wss://api.seu-dominio.com
